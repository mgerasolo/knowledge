
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Spike (pre-alpha prototype - throwaway code)
spike/node_modules/
spike/.env

# Symlinks to shared infrastructure (not project code)
standards
protocols

# Planning backups (local safety nets, not tracked)
_backups/

# Environment and secrets
.env
*.env.local
deploy/.env
deploy/data/
transcripts

# Re-index worker state (scratch; regenerated on each run)
scripts/.reindex_progress.txt
scripts/.reindex_failures.log

# Spike scratch state — logs and fetch/video state snapshots, not source
spike/surreal-rag/scripts/*.log
spike/surreal-rag/scripts/fetch_state*.json
spike/surreal-rag/scripts/video_list*.json
spike/surreal-rag/scripts/repair_state.json
spike/surreal-rag/scripts/fetch_log.txt
__pycache__/
*.pyc
src/admin/static/vendor/
.venv-test/

# Runtime state written by Claude Code sessions — churns constantly, means
# nothing to another checkout, and one of them is a binary SQLite file.
.claude/db/
.claude/handoff-state.json

# Symlinks into the /mnt shares. They resolve only on hosts that mount them,
# so committing them breaks the checkout everywhere else.
/transcripts
/foundry_devlab
/foundry_protocols
/foundry_resources
/foundry_standards
/.claude/herding

# Timestamped hand-made backups (docker-compose.yml.bak.20260808 and friends)
*.bak.*
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/
